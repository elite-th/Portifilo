// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── توشه‌ی مغز — Brain Archive ───
// type: "TOSHEH" | "ARTICLE" | "POEM" — validated in API layer (SQLite has no enum)
// tags: JSON.stringify(string[]) — SQLite has no array type
// readingTime (ARTICLE only): server-computed minutes from content
// mood/source (TOSHEH only), emotion/dedicatedTo (POEM only)
model Entry {
  id           String   @id @default(cuid())
  type         String
  title        String
  content      String
  excerpt      String?
  tags         String?
  mood         String?
  source       String?
  emotion      String?
  dedicatedTo  String?
  readingTime  Int?
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([type])
  @@index([createdAt])
}

// ─── Projects — Crystallized outcomes ───
// Links to Archive entries via semantic tags
// Each project represents a built structure from a root thought
model Project {
  id             String   @id @default(cuid())
  title          String
  rootThought    String
  builtStructure String
  projectName    String   @unique
  tags           String?  // JSON string array
  href           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([projectName])
}